# Plantilla del archivo de configuración (v1.20.0). SIN claves: es la que se sube a git.
# Cópiala como .env.php en la raíz del proyecto, deja como PRIMERA línea:   <?php exit; ?>
# y completa los valores. El .env.php real NO se sube a git (.gitignore). Cada computador o servidor tiene el suyo.

# DONDE SE CONECTA EL SISTEMA:  1 = VPS (intranet datamaule.cl)   2 = LOCAL (este computador)
# Sin esta línea queda en 1 (VPS).
RESTO_CONEXION=1

# production en el VPS (no muestra errores en pantalla y el log guarda solo errores); development en tu PC
CI_ENV=production

# Bases de datos PostgreSQL de las empresas. "localhost", "aws" y "aws_test" son los nombres de servidor que entrega
# la intranet (validarCliente). En modo local (2) solo se usa "localhost" (por defecto 127.0.0.1:5432, usuario postgres).
MIPDV_DB_LOCALHOST_HOSTNAME=
MIPDV_DB_LOCALHOST_PORT=5432
MIPDV_DB_LOCALHOST_USERNAME=
MIPDV_DB_LOCALHOST_PASSWORD=
MIPDV_DB_AWS_HOSTNAME=
MIPDV_DB_AWS_PORT=5432
MIPDV_DB_AWS_USERNAME=
MIPDV_DB_AWS_PASSWORD=

# Intranet (solo modo 1): API del login y de las empresas
MIPDV_APP_WEB_LOGIN_APIKEY=
validar_cliente_legacy_user=
validar_cliente_legacy_pass=

# Modo local (2): base y empresa con que entra el login local (/login/dev)
RESTO_DEV_SERVIDOR=localhost
RESTO_DEV_BASE=dataRestoWeb
RESTO_DEV_CONEXION=
# Otras IP de la red local que pueden usar el login local, separadas por coma (solo IP privadas)
RESTO_DEV_IPS=

# Dirección del sitio (si no está en la lista de config.php), ej. https://resto.datamaule.cl/
RESTO_BASE_URL=

# Claves de cifrado: 64 hexadecimales cada una. Para generarlas:
#   php -r "echo bin2hex(random_bytes(32));"
# No las cambies una vez usadas: lo cifrado con ellas (API Key de facturación) no se podría leer.
RESTO_ENCRYPTION_KEY=
RESTO_DTE_TOKEN_KEY=

# Correo para "¿Olvidaste tu contraseña?" (los cierres de caja usan el correo configurado en cada empresa)
MIPDV_SMTP_HOST=
MIPDV_SMTP_PORT=465
MIPDV_SMTP_USER=
MIPDV_SMTP_PASS=
MIPDV_SMTP_CRYPTO=ssl

# Nivel del log (0 a 4). Vacío: 1 (solo errores) en producción y 4 (todo) en desarrollo.
RESTO_LOG_NIVEL=

# Plantilla del archivo de configuración (v1.24.4). SIN claves: es la que se sube a git.
# Cópiala como .env.php en la raíz del proyecto, deja como PRIMERA línea:   <?php exit; ?>
# y completa los valores. El .env.php real NO se sube a git (.gitignore). Cada computador o servidor tiene el suyo.
#
# IMPORTANTE AL SUBIR AL VPS: nunca copies tu .env.php del computador encima del .env.php del VPS (el tuyo es de
# desarrollo: otra base, otra clave de PostgreSQL y sin las claves de cifrado). Lo mismo con
# application/config/api_movil.php y application/config/caja_local.php.
#
# Lo que el servidor ya define (SetEnv de Apache, fastcgi_param de Nginx) gana sobre este archivo.

# DONDE SE CONECTA EL SISTEMA:  1 = VPS (intranet datamaule.cl)   2 = LOCAL (este computador)
# Sin esta línea queda en 1 (VPS).
RESTO_CONEXION=1

# production en el VPS (no muestra errores en pantalla y el log guarda solo errores); development en tu PC
CI_ENV=production

# Dirección del sitio, ej. https://resto.datamaule.cl/ (resto.datamaule.cl ya está en la lista de config.php;
# con esta línea se fija igual)
RESTO_BASE_URL=https://resto.datamaule.cl/

# Bases de datos PostgreSQL de las empresas. "localhost", "aws" y "aws_test" son los nombres de servidor que entrega
# la intranet (validarCliente). En modo local (2) solo se usa "localhost" (por defecto 127.0.0.1:5432, usuario postgres).
MIPDV_DB_LOCALHOST_HOSTNAME=
MIPDV_DB_LOCALHOST_PORT=5432
MIPDV_DB_LOCALHOST_USERNAME=
MIPDV_DB_LOCALHOST_PASSWORD=
MIPDV_DB_AWS_HOSTNAME=
MIPDV_DB_AWS_PORT=5432
MIPDV_DB_AWS_USERNAME=
MIPDV_DB_AWS_PASSWORD=
MIPDV_DB_AWS_TEST_HOSTNAME=
MIPDV_DB_AWS_TEST_PORT=5432
MIPDV_DB_AWS_TEST_USERNAME=
MIPDV_DB_AWS_TEST_PASSWORD=

# Intranet (solo modo 1): login y empresas. Las direcciones vacías usan las de datamaule.cl (las de siempre).
MIPDV_APP_WEB_LOGIN_APIKEY=
MIPDV_APP_WEB_LOGIN_URL=
validar_cliente_legacy_user=
validar_cliente_legacy_pass=
MIPDV_VALIDAR_CLIENTE_URL=
MIPDV_VALIDAR_CLIENTE_URL_RESPALDO=
# Firma de las consultas a validarCliente (vacía = sin firma, como siempre)
MIPDV_VALIDAR_CLIENTE_HMAC_SECRET=

# Claves de cifrado: 64 hexadecimales cada una. Para generarlas:
#   php -r "echo bin2hex(random_bytes(32));"
# NO LAS CAMBIES una vez usadas: lo cifrado con ellas (API Key de facturación) no se podría leer. En el VPS deben
# quedar las mismas que ya tiene.
RESTO_ENCRYPTION_KEY=
RESTO_DTE_TOKEN_KEY=

# Folio interno que se manda al proveedor de facturación: se suma este número (vacío = 0). Solo si el proveedor
# reclama folios internos repetidos.
RESTO_DTE_FOLIO_INTERNO_BASE=

# AGENTE DE IMPRESIÓN de cada caja (impresionWeb.exe). La Caja (el navegador) le manda los trabajos.
# Dirección del agente en el computador de la caja (vacía = http://localhost:5050)
RESTO_IMPRESION_LOCAL_URL=
# "usuario:clave" del agente. Debe ser LA MISMA que tienen los agentes instalados en los locales: si no coincide,
# la Caja no puede imprimir ("El agente de impresión de este equipo rechazó la clave"). Vacía = sin clave.
RESTO_IMPRESION_LOCAL_CLAVE=

# Correo para "¿Olvidaste tu contraseña?" (los cierres de caja usan el correo configurado en cada empresa)
MIPDV_SMTP_HOST=
MIPDV_SMTP_PORT=465
MIPDV_SMTP_USER=
MIPDV_SMTP_PASS=
MIPDV_SMTP_CRYPTO=ssl

# Zona horaria de PHP (vacía = America/Santiago)
RESTO_ZONA_HORARIA=

# Nivel del log (0 a 4). Vacío: 1 (solo errores) en producción y 4 (todo) en desarrollo.
RESTO_LOG_NIVEL=

# Solo modo local (2): base y empresa con que entra el login local (/login/dev). En el VPS no se usan.
RESTO_DEV_SERVIDOR=localhost
RESTO_DEV_BASE=DataRestoWeb
RESTO_DEV_CONEXION=
# Otras IP de la red local que pueden usar el login local, separadas por coma (solo IP privadas)
RESTO_DEV_IPS=

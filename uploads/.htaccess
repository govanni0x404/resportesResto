# Solo imágenes subidas por el sistema: nunca se ejecuta código desde esta carpeta ni se listan archivos
Options -Indexes -ExecCGI
<FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
